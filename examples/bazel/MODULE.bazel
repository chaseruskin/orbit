"""Multi-package HDL workspace demonstrating gazelle_orbit.

This module shows a small HDL design split across two Bazel packages
(//primitives and //gates), each its own orbit project with its own HDL
library. Running `bazel run :gazelle` regenerates the per-package BUILD
files with vhdl_library targets and resolves cross-package deps.
"""

module(
    name = "bazel_example",
    version = "0.0.0",
)

bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_venv", version = "0.18.0")
bazel_dep(name = "rules_req_compile", version = "1.1.3")
bazel_dep(name = "rules_systemrdl", version = "0.3.0")
bazel_dep(name = "rules_verilog", version = "1.1.1")
bazel_dep(name = "rules_vhdl", version = "0.1.1")
bazel_dep(name = "platforms", version = "1.1.0")

# Consume the gazelle_orbit plugin from the parent repo.
bazel_dep(name = "gazelle_orbit", version = "0.0.0")
local_path_override(
    module_name = "gazelle_orbit",
    path = "../..",
)

# Go toolchain needed by gazelle's runtime.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

# Load dependencies for systemrdl
requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements")
requirements.parse(
    name = "pip_deps",
    requirements_locks = {
        "//tools/requirements:requirements_linux_aarch64.txt": "//tools/requirements:linux_aarch64",
        "//tools/requirements:requirements_linux_x86_64.txt": "//tools/requirements:linux_x86_64",
        "//tools/requirements:requirements_macos_aarch64.txt": "//tools/requirements:macos_aarch64",
        "//tools/requirements:requirements_windows_x86_64.txt": "//tools/requirements:windows_x86_64",
    },
)
use_repo(requirements, "pip_deps")

# Register the systemrdl toolchain
register_toolchains("//tools/toolchains:system_rdl")
