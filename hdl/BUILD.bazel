"""hdl_library — mixed-language HDL library rule for gazelle_orbit users."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "defs.bzl",
        "hdl_library.bzl",
    ],
)

bzl_library(
    name = "hdl_library_bzl",
    srcs = ["hdl_library.bzl"],
    deps = [
        "@rules_verilog//verilog:defs_bzl",
        "@rules_vhdl//vhdl:defs_bzl",
    ],
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    deps = [":hdl_library_bzl"],
)
